# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://shorts:shorts@postgres:5432/shorts

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ── AI services ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
HEYGEN_API_KEY=

# Storyblocks API — тёмные 3D медицинские анимации (как у BioBase12)
# Регистрация + тестовые ключи: https://developer.storyblocks.com
# При регистрации даётся 5 бесплатных загрузок. Полный план ~$15/мес.
STORYBLOCKS_PUBLIC_KEY=
STORYBLOCKS_PRIVATE_KEY=
STORYBLOCKS_PROJECT_ID=

# ── YouTube OAuth ─────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_SECRETS_FILE=/app/secrets/client_secret.json
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8000/api/channels/oauth-callback

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PATH=/app/storage

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=changeme

# ── Limits ────────────────────────────────────────────────────────────────────
DAILY_UPLOAD_QUOTA_PER_PROJECT=6
DEFAULT_VIDEO_FPS=30
DEFAULT_VIDEO_RESOLUTION=1080x1920

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Аутентификация (NextAuth) ──────────────────────────────────────────────────
# Генерация секрета: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL приложения (prod: http://shorts.v3techbots.online или свой домен)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com → APIs & Services → Credentials)
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram Bot (@BotFather → /newbot → /setdomain → укажи домен)
# Узнать свой Telegram ID: напиши боту @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=mybot  # без @

# Список разрешённых пользователей (через запятую, без пробелов)
# Оставь пустым — пустит всех кто прошёл OAuth (не рекомендуется)
ALLOWED_EMAILS=your@gmail.com
ALLOWED_TELEGRAM_IDS=123456789

# ── Optional: Sentry ──────────────────────────────────────────────────────────
SENTRY_DSN=
